<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.CampsiteCommander" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Primary brand colors -->
        <item name="colorPrimary">@color/primary_red</item>
        <item name="colorPrimaryDark">@color/dark_red</item>
        <item name="colorAccent">@color/secondary_red</item>
        <!-- Custom attribute for secondary red (used in text hover, etc.) -->
        <item name="colorSecondary">@color/secondary_red</item>
        <!-- Background and surface -->
        <item name="android:colorBackground">@color/background_white</item>
        <item name="colorSurface">@color/surface_light_grey</item>
        <item name="android:windowBackground">@color/background_white</item>
        <!-- Text colors -->
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <!-- Button styling -->
        <item name="materialButtonStyle">@style/Widget.CampsiteCommander.Button</item>
        <!-- Card styling -->
        <item name="materialCardViewStyle">@style/Widget.CampsiteCommander.Card</item>
    </style>

    <!-- Button Style -->
    <style name="Widget.CampsiteCommander.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">@color/primary_red</item>
        <item name="android:textColor">@color/button_text_white</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:stateListAnimator" ns:ignored="true">@null</item>
        <item name="elevation">4dp</item>
    </style>

    <!-- Card Style -->
    <style name="Widget.CampsiteCommander.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">4dp</item>
        <item name="contentPadding">16dp</item>
        <item name="cardBackgroundColor">@color/background_white</item>
    </style>

</resources>
