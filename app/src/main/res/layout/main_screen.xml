<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/mainLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light_grey"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <View
                android:layout_width="5dp"
                android:layout_height="40dp"
                android:background="@color/primary_red" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Packing List"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginStart="12dp" />

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/ic_campfire"
                android:contentDescription="Camping" />
        </LinearLayout>

        <!-- Summary Info Card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:layout_marginBottom="24dp"
            android:padding="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TOTAL ITEMS PACKED"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:textAllCaps="true"
                    android:letterSpacing="0.12" />

                <TextView
                    android:id="@+id/txtTotalItems"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textSize="56sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_red"
                    android:layout_marginTop="8dp" />

                <View
                    android:layout_width="80dp"
                    android:layout_height="3dp"
                    android:background="@color/secondary_red"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="8dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Items ready for adventure"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary" />

            </LinearLayout>
        </FrameLayout>

        <!-- Actions Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACTIONS"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:textAllCaps="true"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="4dp" />

        <!-- Add Gear Button -->
        <Button
            android:id="@+id/btnAddGear"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="ADD GEAR ITEM"
            android:textAllCaps="true"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/button_text_white"
            android:background="@drawable/bg_red_button"
            android:layout_marginBottom="12dp" />

        <!-- View All Items Button -->
        <Button
            android:id="@+id/btnViewAllItems"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="VIEW ALL ITEMS"
            android:textAllCaps="true"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/button_text_white"
            android:background="@drawable/bg_red_button"
            android:layout_marginBottom="12dp" />

        <!-- Clear All Data Button -->
        <Button
            android:id="@+id/btnClearAll"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="CLEAR ALL DATA"
            android:textAllCaps="true"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/primary_red"
            android:background="@drawable/bg_outlined_button" />

    </LinearLayout>

</ScrollView>
