<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/splashLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/background_white"
    android:padding="32dp">

    <View
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@color/primary_red"
        android:layout_gravity="top" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_campfire"
        android:contentDescription="Camping icon"
        android:elevation="6dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Campsite Commander"
        android:textSize="36sp"
        android:textStyle="bold"
        android:textColor="@color/primary_red"
        android:gravity="center"
        android:layout_marginTop="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Outdoor Adventure Inventory"
        android:textSize="16sp"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginTop="8dp" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <Button
        android:id="@+id/btnStart"
        android:layout_width="240dp"
        android:layout_height="56dp"
        android:text="GET STARTED"
        android:textAllCaps="true"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/button_text_white"
        android:background="@drawable/bg_red_button"
        android:gravity="center" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="32dp" />

    <View
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@color/primary_red" />

</LinearLayout>
