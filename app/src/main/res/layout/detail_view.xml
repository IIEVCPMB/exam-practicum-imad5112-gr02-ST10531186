<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/detailLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/surface_light_grey"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="20dp">

            <View
                android:layout_width="5dp"
                android:layout_height="40dp"
                android:background="@color/primary_red" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Camp Checklist"
                android:textSize="28sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginStart="12dp" />
        </LinearLayout>

        <!-- Gear Items Display Card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:layout_marginBottom="20dp"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="GEAR ITEMS"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:textAllCaps="true"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/txtDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No items added yet."
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:lineSpacingExtra="6dp" />

            </LinearLayout>
        </FrameLayout>

        <!-- Add New Item Card -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_white"
            android:layout_marginBottom="20dp"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ADD NEW ITEM"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:textAllCaps="true"
                    android:layout_marginBottom="16dp" />

                <!-- Item Spinner -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Select Gear Item"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp" />

                <Spinner
                    android:id="@+id/spinnerItems"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_spinner"
                    android:paddingHorizontal="12dp"
                    android:layout_marginBottom="12dp" />

                <!-- Category Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Category (e.g. Shelter, Food, Tools)"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp" />

                <EditText
                    android:id="@+id/editCategory"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_edit_text"
                    android:inputType="text"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="12dp" />

                <!-- Quantity Input -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quantity / Comment"
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginBottom="8dp"
                    android:layout_marginStart="4dp" />

                <EditText
                    android:id="@+id/editQuantity"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/bg_edit_text"
                    android:inputType="text"
                    android:textSize="16sp"
                    android:textColor="@color/text_primary"
                    android:layout_marginBottom="20dp" />

                <!-- Save Button -->
                <Button
                    android:id="@+id/btnSaveItem"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="SAVE ITEM"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/button_text_white"
                    android:background="@drawable/bg_red_button"
                    android:layout_marginBottom="12dp" />

                <!-- View Items Button -->
                <Button
                    android:id="@+id/btnItems"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="VIEW ITEMS"
                    android:textAllCaps="true"
                    android:textStyle="bold"
                    android:textSize="16sp"
                    android:textColor="@color/primary_red"
                    android:background="@drawable/bg_outlined_button" />

            </LinearLayout>
        </FrameLayout>

        <!-- Actions Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="ACTIONS"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            android:textAllCaps="true"
            android:layout_marginBottom="12dp"
            android:layout_marginStart="4dp" />

        <!-- View Comments Button -->
        <Button
            android:id="@+id/btnComments"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="VIEW COMMENTS"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/button_text_white"
            android:background="@drawable/bg_red_button"
            android:layout_marginBottom="12dp" />

        <!-- Clear Data Button -->
        <Button
            android:id="@+id/btnClear"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="CLEAR DATA"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/primary_red"
            android:background="@drawable/bg_outlined_button"
            android:layout_marginBottom="12dp" />

        <!-- Back to Base Button -->
        <Button
            android:id="@+id/btnBack"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="BACK TO BASE"
            android:textAllCaps="true"
            android:textStyle="bold"
            android:textSize="16sp"
            android:textColor="@color/button_text_white"
            android:background="@drawable/bg_red_button" />

    </LinearLayout>

</ScrollView>
